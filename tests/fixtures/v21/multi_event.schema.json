{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/schemas/v21/multi-event-fixture.schema.json",
  "title": "AgentGuard V21 multi-event regression fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "label", "steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "trace_id": {"type": "string", "minLength": 1},
    "label": {"enum": ["attack", "benign"]},
    "attack_type": {"type": ["string", "null"]},
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "event_id", "action_id", "parent_step_ids", "parent_action_ids", "event"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "action_id": {"type": "string", "minLength": 1},
          "parent_step_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "parent_action_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "event": {
            "type": "object",
            "required": ["schema_version", "event_id", "event_type", "runtime", "trace_id", "timestamp", "pre_execution", "security_context", "payload", "metadata"]
          }
        }
      }
    }
  }
}
