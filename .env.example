AGENTGUARD_ENV=development
AGENTGUARD_STORAGE_BACKEND=postgres
AGENTGUARD_DATABASE_URL=postgresql+psycopg://postgres:123456@127.0.0.1:5432/agent_guard
AGENTGUARD_TEST_DATABASE_URL=postgresql+psycopg://postgres:123456@127.0.0.1:5432/agent_guard_test
# Guard API 启动后，用 agentguardctl credential issue 签发并仅配置给对应 Adapter。
AGENTGUARD_ADAPTER_TOKEN=
AGENTGUARD_CONTROL_TOKEN=change-me-control-token
# Task API 使用独立 keyring；生产必须配置，轮换时保留仍被 TaskFact 引用的旧 key。
AGENTGUARD_TASK_SCOPE_ACTIVE_KEY_ID=
AGENTGUARD_TASK_SCOPE_KEYS=
AGENTGUARD_HOST=127.0.0.1
AGENTGUARD_PORT=8088
AGENTGUARD_BROWSER_COOKIE_SECURE=false
AGENTGUARD_MAX_REQUEST_BODY_BYTES=1048576
# 开发环境可留空；生产或对外监听时三项必须同时配置。
AGENTGUARD_AUDIT_CHECKPOINT_PATH=
AGENTGUARD_AUDIT_CHECKPOINT_KEY=
AGENTGUARD_AUDIT_CHECKPOINT_KEY_ID=
AGENTGUARD_AUDIT_CHECKPOINT_INTERVAL_SECONDS=300
# V2.1 authority mode: off | shadow | limited_enable | active.
AGENTGUARD_V21_MODE=off
# Official modes require a signed, absolute, read-only activation manifest.
AGENTGUARD_V21_COMPETITION_ACTIVATION_PATH=
# Base64url server secret (decoded length >= 32 bytes) for V2.1 evidence/signing.
AGENTGUARD_V21_SHADOW_SERVER_SECRET=
AGENTGUARD_LLM_APPROVAL_ENABLED=false
AGENTGUARD_LLM_APPROVAL_BASE_URL=https://api.openai.com/v1
AGENTGUARD_LLM_APPROVAL_API_KEY=
AGENTGUARD_LLM_APPROVAL_MODEL=
AGENTGUARD_LLM_APPROVAL_TIMEOUT_SECONDS=3
