{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/roadmap/node.schema.json",
  "title": "AgentGuard roadmap node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "exact_title", "kind", "roles", "lane",
    "lifecycle", "revision", "optional", "blocked", "hold",
    "change_surfaces", "source_refs", "evidence_refs", "work", "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$"},
    "exact_title": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["task", "gate", "stage", "acceptance", "baseline", "final"]
    },
    "roles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["task", "gate", "stage", "acceptance", "baseline", "final"]}
    },
    "lane": {
      "enum": ["baseline", "core", "ct", "rte", "fe", "integration", "stage", "gate", "acceptance", "final"]
    },
    "lifecycle": {
      "enum": ["not_started", "in_progress", "completed", "deferred", "not_applicable"]
    },
    "revision": {"type": "integer", "minimum": 0},
    "optional": {"type": "boolean"},
    "blocked": {"type": "boolean"},
    "hold": {"type": "boolean"},
    "change_surfaces": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_refs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/source_ref"}
    },
    "evidence_refs": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^evidence/.+\\.json$"}
    },
    "acceptance_parent": {"type": ["string", "null"]},
    "work": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/work"}
      ]
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "heading", "line_hint"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "heading": {"type": "string", "minLength": 1},
        "line_hint": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]}
      }
    },
    "work": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "worktree_slug", "owner", "base_sha", "started_at", "substate"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "worktree_slug": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "substate": {"enum": ["allocated", "active", "branch_verified", "awaiting_integration", "closed"]},
        "completed_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    }
  }
}
