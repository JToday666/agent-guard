{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.dev/schemas/roadmap/roadmap.schema.json",
  "title": "AgentGuard roadmap catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "baseline_ref",
    "nodes_dir",
    "edges_dir",
    "evidence_dir",
    "decisions_dir",
    "generated_files",
    "lanes",
    "exclusive_surfaces",
    "state_palette",
    "authorities"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "baseline_ref": { "type": "string", "minLength": 1 },
    "nodes_dir": { "const": "nodes" },
    "edges_dir": { "const": "edges" },
    "evidence_dir": { "const": "evidence" },
    "decisions_dir": { "const": "decisions" },
    "generated_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "order"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "order": { "type": "integer" }
        }
      }
    },
    "exclusive_surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path_patterns"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "path_patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "state_palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "in_progress", "ready", "not_ready"],
      "properties": {
        "completed": { "$ref": "#/$defs/state_style" },
        "in_progress": { "$ref": "#/$defs/state_style" },
        "ready": { "$ref": "#/$defs/state_style" },
        "not_ready": { "$ref": "#/$defs/state_style" }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "name", "paths", "rule"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "name": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "rule": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "state_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "color", "icon"],
      "properties": {
        "label": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "icon": { "type": "string", "minLength": 1 }
      }
    }
  }
}
