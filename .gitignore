# Python environment
.venv/
.uv-cache/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.pyright/
build/
dist/
release-dist/
*.whl
*.tar.gz

# Node dependencies
**/node_modules/
.pnpm-store/

# OpenClaw local development staging and backups
.openclaw-dev/

# Local environment files
**/.env*
!**/.env.example
!**/.env.*.example

# Project agent instructions. Keep only the repository-root memory tracked.
**/AGENTS.md
!/AGENTS.md
.agents/skills/frontend-design/
question-record/

# Dashboard caches
apps/dashboard/.vite/
apps/dashboard/*.tsbuildinfo

# Dashboard build outputs
apps/dashboard/dist/
apps/dashboard/dist-ssr/
apps/dashboard/playwright-report/
apps/dashboard/test-results/
apps/dashboard/test-results-api/
apps/dashboard/test-results-s1-live-*/

# Logs
*.log
pnpm-debug.log*

# Qoder IDE 本地工作目录（含 repowiki 与 better-harness 自动生成的本地数据）
.qoder/

# 本地临时工作区（review diff、uv 缓存副本等）
.tmp/

# 本地临时诊断/启动脚本（.diag_*.py、.fullrun-launch.sh 等）
.diag_*.py
.fullrun-launch.sh

# 实验报告输出目录；仅允许受审查的规范基线说明入库。
reports/*
!reports/baselines/
reports/baselines/*
!reports/baselines/README.md
