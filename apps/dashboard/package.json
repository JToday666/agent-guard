{
  "name": "@agentguard/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --build --force",
    "check:changed": "bash ../../scripts/dashboard-check-changed.sh",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "test:e2e:api": "playwright test --config=playwright.api.config.ts",
    "test:e2e:roadmap": "playwright test --config=playwright.roadmap.config.ts",
    "test:e2e:s1-live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:s2-live": "playwright test --config=playwright.s2-live.config.ts",
    "build": "vue-tsc --build --force && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/vue": "^1.21.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "elkjs": "^0.12.0",
    "pinia": "3.0.4",
    "vue": "3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.2",
    "@vitejs/plugin-vue": "6.0.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "sass": "1.101.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.1.0",
    "vue-tsc": "3.3.5"
  }
}
