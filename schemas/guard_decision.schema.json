{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardDecision",
  "type": "object",
  "required": [
    "decision_id",
    "decision",
    "risk_score",
    "severity",
    "categories",
    "rule_hits",
    "reason",
    "approval_intent"
  ],
  "properties": {
    "decision_id": { "type": "string" },
    "decision": { "enum": ["allow", "deny", "ask"] },
    "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "severity": { "type": "string" },
    "categories": { "type": "array", "items": { "type": "string" } },
    "rule_hits": { "type": "array", "items": { "type": "object" } },
    "reason": { "type": "string" },
    "safe_message": { "type": ["string", "null"] },
    "approval_intent": {
      "anyOf": [
        {
          "type": "object",
          "required": ["options", "resource"],
          "properties": {
            "options": { "type": "array", "items": { "enum": ["allow_once", "deny"] } },
            "resource": { "type": "string" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "latency_ms": { "type": ["integer", "null"] },
    "enforcement": {
      "anyOf": [
        {
          "type": "object",
          "required": ["mode", "actual_decision", "policy_decision"],
          "properties": {
            "mode": { "enum": ["enforce", "audit_only", "shadow_deny", "modify"] },
            "actual_decision": { "enum": ["allow", "deny", "ask"] },
            "policy_decision": { "enum": ["allow", "deny", "ask"] },
            "reason": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        { "type": "null" }
      ]
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["effect_type", "target", "description"],
        "properties": {
          "effect_type": { "enum": ["would_block", "patch", "audit", "quarantine"] },
          "target": { "type": "string" },
          "description": { "type": "string" },
          "patch": { "type": ["object", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
