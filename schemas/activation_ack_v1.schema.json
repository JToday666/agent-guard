{
  "$id": "https://agentguard.dev/schemas/activation_ack_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "langgraph"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "properties": {
          "plugin_inventory_digest": {
            "type": "null"
          },
          "plugin_order_inventory_digest": {
            "type": "null"
          },
          "plugin_version": {
            "const": "0.1.0rc1"
          },
          "profile_id": {
            "const": "agentguard-langgraph-v2"
          },
          "runtime_version": {
            "const": "1.2.7"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "const": "openclaw"
          }
        },
        "required": [
          "runtime"
        ]
      },
      "then": {
        "properties": {
          "plugin_inventory_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "plugin_order_inventory_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "plugin_version": {
            "const": "0.1.0-rc.1"
          },
          "profile_id": {
            "const": "agentguard-openclaw-v2-restricted"
          },
          "runtime_version": {
            "const": "2026.7.1-2"
          }
        },
        "required": [
          "plugin_inventory_digest",
          "plugin_order_inventory_digest"
        ]
      }
    }
  ],
  "description": "Short-lived server acknowledgement of exact runtime activation identity.",
  "properties": {
    "ack_token": {
      "pattern": "^hmac-sha256:[0-9a-f]{64}$",
      "title": "Ack Token",
      "type": "string"
    },
    "activation_ref_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Activation Ref Digest",
      "type": "string"
    },
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "capability_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Capability Digest",
      "type": "string"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    },
    "host_inventory_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Host Inventory Digest",
      "type": "string"
    },
    "issued_at": {
      "title": "Issued At",
      "type": "string"
    },
    "plugin_inventory_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plugin Inventory Digest"
    },
    "plugin_order_inventory_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plugin Order Inventory Digest"
    },
    "plugin_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Plugin Version",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "runtime": {
      "enum": [
        "langgraph",
        "openclaw"
      ],
      "title": "Runtime",
      "type": "string"
    },
    "runtime_binding_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Runtime Binding Id",
      "type": "string"
    },
    "runtime_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Runtime Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_inventory_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Tool Inventory Digest",
      "type": "string"
    }
  },
  "required": [
    "runtime",
    "runtime_version",
    "plugin_version",
    "agent_id",
    "runtime_binding_id",
    "profile_id",
    "activation_ref_digest",
    "capability_digest",
    "host_inventory_digest",
    "tool_inventory_digest",
    "issued_at",
    "expires_at",
    "ack_token"
  ],
  "title": "ActivationAckV1",
  "type": "object"
}
