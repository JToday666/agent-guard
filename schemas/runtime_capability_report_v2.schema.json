      "title": "Runtime",
      "type": "string"
    },
    "runtime_binding_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Runtime Binding Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supported": {
      "title": "Supported",
      "type": "boolean"
    }
