{
  "$defs": {
    "RuntimeEventCapabilityV2": {
      "additionalProperties": false,
      "description": "One runtime's truthful capability at a concrete GuardEvent boundary.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "enforcement": {
          "enum": [
            "observation",
            "pre_execution_c1",
            "pre_execution_c3",
            "post_execution_isolation",
            "not_supported"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "tool_call_proposed",
            "context_assembled",
            "model_input_prepared",
            "model_output_produced",
            "tool_result_produced",
            "memory_write_proposed",
            "message_send_proposed"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "residual_boundaries": {
          "items": {
            "enum": [
              "openclaw_has_no_authoritative_invocation_start_hook",
              "openclaw_hook_cannot_atomically_replace_and_seal_final_action",
              "openclaw_message_sending_host_exception_or_timeout_can_fail_open",
              "openclaw_non_tool_memory_write_has_no_native_pre_execution_hook",
              "openclaw_sync_persistence_hooks_cannot_await_remote_decision_or_rollback"
            ],
            "type": "string"
          },
          "title": "Residual Boundaries",
          "type": "array"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        }
      },
      "required": [
        "event_type",
        "supported",
        "active",
        "enforcement",
        "residual_boundaries"
      ],
      "title": "RuntimeEventCapabilityV2",
      "type": "object"
    }
  },
  "$id": "https://agentguard.dev/schemas/runtime_capability_report_v2.schema.json",
