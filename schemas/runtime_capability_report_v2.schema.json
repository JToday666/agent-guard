  "description": "Runtime capability report separating support from activation state.",
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "c0_registration": {
      "title": "C0 Registration",
      "type": "boolean"
    },
    "c1_pre_execution_interception": {
      "title": "C1 Pre Execution Interception",
      "type": "boolean"
    },
    "c2_correlation": {
      "title": "C2 Correlation",
      "type": "boolean"
    },
    "c3_atomic_replace_and_seal": {
      "title": "C3 Atomic Replace And Seal",
      "type": "boolean"
    },
    "c4_outcome_receipts": {
      "title": "C4 Outcome Receipts",
      "type": "boolean"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/RuntimeEventCapabilityV2"
      },
      "title": "Events",
      "type": "array"
    },
    "profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Report Digest",
      "type": "string"
    },
    "residual_boundaries": {
      "items": {
        "enum": [
          "openclaw_has_no_authoritative_invocation_start_hook",
          "openclaw_hook_cannot_atomically_replace_and_seal_final_action",
          "openclaw_message_sending_host_exception_or_timeout_can_fail_open",
          "openclaw_non_tool_memory_write_has_no_native_pre_execution_hook",
          "openclaw_sync_persistence_hooks_cannot_await_remote_decision_or_rollback"
