{
  "id": "agentguard-security",
  "name": "AgentGuard Security",
  "description": "Evaluates OpenClaw tool calls and outbound messages through AgentGuard Guard API.",
  "version": "0.1.0-beta.1",
  "activation": {
    "onStartup": true
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "adapterToken",
          "expected": "string"
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["adapterToken"],
    "properties": {
      "guardApiBaseUrl": {
        "type": "string",
        "minLength": 1,
        "format": "uri",
        "description": "Guard API URL. HTTP is allowed only for explicit loopback addresses; remote targets require HTTPS and redirects are rejected.",
        "default": "http://127.0.0.1:8088"
      },
      "adapterToken": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "provider", "id"],
            "properties": {
              "source": {
                "type": "string",
                "enum": ["env", "file", "exec"]
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      },
      "enforcementMode": {
        "type": "string",
        "enum": ["enforce", "observe", "disabled"],
        "default": "enforce"
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "approvalPollIntervalMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "approvalTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000,
        "default": 25000
      },
      "diagnosticLogging": {
        "type": "boolean"
      },
      "agentId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "default": "main"
      }
    }
  },
  "uiHints": {
    "guardApiBaseUrl": {
      "label": "Guard API base URL",
      "placeholder": "http://127.0.0.1:8088"
    },
    "adapterToken": {
      "label": "AgentGuard adapter token SecretRef",
      "help": "Use an OpenClaw SecretRef; plaintext tokens are not accepted.",
      "sensitive": true
    },
    "enforcementMode": {
      "label": "Enforcement mode"
    },
    "diagnosticLogging": {
      "label": "Diagnostic logging"
    },
    "agentId": {
      "label": "Bound agent ID"
    }
  }
}
