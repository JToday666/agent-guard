{
  "id": "agentguard-security",
  "name": "AgentGuard Security",
  "description": "Evaluates OpenClaw tool calls and outbound messages through AgentGuard Guard API.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "guardApiBaseUrl": {
        "type": "string"
      },
      "adapterToken": {
        "type": "string"
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "approvalPollIntervalMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "approvalTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "approvalWaitBudgetMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "diagnosticLogging": {
        "type": "boolean"
      }
    }
  },
  "uiHints": {
    "guardApiBaseUrl": {
      "label": "Guard API base URL",
      "placeholder": "http://127.0.0.1:8088"
    },
    "adapterToken": {
      "label": "AgentGuard adapter token",
      "sensitive": true
    },
    "diagnosticLogging": {
      "label": "Diagnostic logging"
    }
  }
}
