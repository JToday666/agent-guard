{
  "name": "@agentguard/openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentGuard security hooks for OpenClaw",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "hook-contract.d.mts",
    "hook-contract.mjs",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "openclaw": "2026.6.6"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.6",
      "minGatewayVersion": "2026.6.6"
    },
    "build": {
      "openclawVersion": "2026.6.6",
      "pluginSdkVersion": "2026.6.6"
    }
  }
}
