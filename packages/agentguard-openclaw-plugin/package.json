{
  "name": "@agentguard-ai/openclaw-plugin",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "AgentGuard security hooks for OpenClaw",
  "author": "AEGIS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JToday666/agent-guard.git",
    "directory": "packages/agentguard-openclaw-plugin"
  },
  "homepage": "https://github.com/JToday666/agent-guard#readme",
  "bugs": {
    "url": "https://github.com/JToday666/agent-guard/issues"
  },
  "keywords": [
    "agentguard",
    "openclaw",
    "ai-agent",
    "security",
    "prompt-injection"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "hook-contract.d.mts",
    "hook-contract.mjs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-dist.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.6 <2027.0.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "openclaw": "2026.7.1-2",
    "typescript": "6.0.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.6",
      "minGatewayVersion": "2026.6.6"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
